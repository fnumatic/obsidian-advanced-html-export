{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es6",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "skipLibCheck": true,
    "lib": [
      "dom",
      "es5",
      "scripthost",
      "es2019"
    ],
    "types": ["svelte"]
  },
  "include": [
    "**/*.ts",
    "**/*.svelte"
  ]
}
