{
  "name": "obsidian-advanced-html-export",
  "version": "0.6.8",
  "description": "Export Obsidian notes as self-contained HTML files with advanced features",
  "main": "main.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:default": "node scripts/dev-default.cjs",
    "preview": "node scripts/copy-to-vault.cjs",
    "build": "vite build && cp manifest.json dist/",
    "type-check": "tsc --noEmit",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-workflow": "./bin/act push --eventpath push_event.json -P ubuntu-latest=catthehacker/ubuntu:act-latest"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@iconify-json/carbon": "^1.2.24",
    "@iconify-json/mdi": "^1.2.3",
    "@lezer/common": "^1.5.2",
    "@release-it/conventional-changelog": "^11.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/chai": "^5.2.3",
    "@types/node": "^24.13.2",
    "@unocss/extractor-svelte": "^66.7.4",
    "@unocss/preset-icons": "^66.7.4",
    "@unocss/preset-wind4": "^66.7.4",
    "@unocss/vite": "^66.7.4",
    "builtin-modules": "^5.3.0",
    "obsidian": "^1.13.1",
    "release-it": "^20.2.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "unocss": "^66.7.4",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@conventional-changelog/git-client": ">=2.0.0"
  }
}
