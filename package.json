{
  "name": "obsidian-advanced-html-export",
  "version": "0.6.0",
  "description": "Export Obsidian notes as self-contained HTML files with advanced features",
  "main": "main.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:default": "node scripts/dev-default.cjs",
    "preview": "node scripts/copy-to-vault.cjs",
    "build": "vite build && cp manifest.json dist/",
    "type-check": "tsc --noEmit",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-workflow": "./bin/act push --eventpath push_event.json -P ubuntu-latest=catthehacker/ubuntu:act-latest"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@iconify-json/carbon": "^1.2.18",
    "@iconify-json/mdi": "^1.2.3",
    "@lezer/common": "^1.5.0",
    "@release-it/conventional-changelog": "^10.0.4",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/chai": "^5.2.3",
    "@types/node": "^24.10.10",
    "@unocss/extractor-svelte": "^66.6.0",
    "@unocss/preset-icons": "^66.6.0",
    "@unocss/preset-wind4": "^66.6.0",
    "@unocss/vite": "^66.6.0",
    "builtin-modules": "^5.0.0",
    "obsidian": "^1.11.4",
    "release-it": "^19.2.4",
    "svelte": "^5.50.0",
    "svelte-check": "^4.3.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unocss": "^66.6.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@conventional-changelog/git-client": ">=2.0.0"
  },
  "pnpm": {
    "overrides": {
      "@conventional-changelog/git-client": ">=2.0.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
